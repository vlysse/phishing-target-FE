VITE_API_URL=http://localhost:4000

# Canonical production host — the app force-redirects here from any other
# hostname (bare vercel URL, sibling subdomain). Leave unset in local dev.
VITE_CANONICAL_HOST=app.tdvx.site

# Login subdomain — guests (and users after logout) are redirected here.
VITE_LOGIN_HOST=login.tdvx.site
